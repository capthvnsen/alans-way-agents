{
  "cdpUrl": "http://127.0.0.1:9222",
  "browserCommand": "/snap/bin/chromium",
  "browserArgs": [
    "--no-sandbox",
    "--user-data-dir=/root/snap/chromium/common/hermes-browser-exec",
    "--remote-debugging-port=9222",
    "--remote-debugging-address=127.0.0.1",
    "--no-first-run",
    "--start-maximized",
    "--disable-dev-shm-usage",
    "--ozone-platform=x11",
    "about:blank"
  ]
}
