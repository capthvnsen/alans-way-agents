[Unit]
Description=Hermes dedicated automation Chromium for the stock browser_exec tool
After=network.target

[Service]
Type=simple
# browser_exec (Browser Use) connects to the cdp_url in the Hermes browser
# config (default http://127.0.0.1:9222). This unit runs a second Chromium
# there with its own --user-data-dir so it never shares a profile with the
# workspace VPS browser on :9223. DISPLAY must match the Xvfb the desktop
# stack uses. HERMES_VPS_BROWSER_DATA points at a directory containing a
# config.json with cdpUrl, browserCommand and browserArgs.
# Run as the account that runs Hermes, not root: Chromium refuses to start as
# root without --no-sandbox. Use a deb Chrome or Chromium (snap Chromium cannot
# open a profile outside ~/snap/chromium/common). Change user and the paths
# in config.json to match your account.
User=user
Environment=DISPLAY=:99
Environment=HERMES_VPS_BROWSER_DATA=/home/user/.local/share/hermes-alans-way/browser-exec
ExecStart=/usr/bin/node /opt/hermes-alans-way/browser/desktop/scripts/vps-chromium-host.cjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
