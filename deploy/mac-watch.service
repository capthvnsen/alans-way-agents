[Unit]
Description=Hermes Alan's Way Mac availability watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as the account whose ~/.ssh can reach the Mac (BatchMode key auth),
# and set HERMES_WORKSPACE_MAC_SSH=you@your-mac and HERMES_WORKSPACE_HOST_OS=mac|windows|linux
# in the environment file
# (or override both with `systemctl edit mac-watch`).
User=hermes
EnvironmentFile=-/etc/hermes-alans-way/mac-watch.env
ExecStart=/usr/bin/node /opt/hermes-alans-way/alans-way/scripts/workspace-router.cjs --watch --interval 10
Restart=always
RestartSec=5
# Exit 2 is a config error (e.g. HERMES_WORKSPACE_MAC_SSH unset): do not loop.
RestartPreventExitStatus=2
StateDirectory=hermes-alans-way

[Install]
WantedBy=multi-user.target
