[Unit]
Description=Hermes Alan's Way Mac availability watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as the account whose ~/.ssh can reach the Mac (BatchMode key auth),
# and set HERMES_WORKSPACE_MAC_SSH=you@your-mac in the environment file
# (or override both with `systemctl edit mac-watch`). Add
# HERMES_WORKSPACE_HOST_OS=windows|linux there when it is not a Mac.
User=hermes
EnvironmentFile=-/etc/hermes-alans-way/mac-watch.env
ExecStart=/opt/hermes-alans-way/alans-way/scripts/mac-watch.sh --interval 10
Restart=always
RestartSec=5
# Exit 2 is a config error (e.g. HERMES_WORKSPACE_MAC_SSH unset): do not loop.
RestartPreventExitStatus=2
StateDirectory=hermes-alans-way

[Install]
WantedBy=multi-user.target
